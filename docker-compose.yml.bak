services:
  mysql:
    image: mysql:8.0
    container_name: escambo-db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: root123
      MYSQL_DATABASE: escambo_dev
      MYSQL_USER: escambo
      MYSQL_PASSWORD: escambo123
    ports:
      - '3306:3306'
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - escambo-net
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      timeout: 20s
      retries: 10
      interval: 5s
    command: --default-authentication-plugin=mysql_native_password

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: escambo-api
    restart: unless-stopped
    environment:
      NODE_ENV: development
      DB_HOST: mysql
      DB_PORT: 3306
      DB_USER: escambo
      DB_PASSWORD: escambo123
      DB_NAME: escambo_dev
      JWT_SECRET: dev-secret-change-in-production
      PORT: 3000
      API_URL: http://localhost:3000
    ports:
      - '3000:3000'
    volumes:
      - ./backend:/app
      - /app/node_modules
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - escambo-net
    command: sh -c "npm run migrate && npm run dev"

  frontend:
    build:
      context: ./frontend-next
      dockerfile: Dockerfile
    container_name: escambo-web
    restart: unless-stopped
    environment:
      NEXT_PUBLIC_API_URL: http://localhost:3000
      DOCKER_ENV: "true"
      NODE_ENV: development
    ports:
      - '5174:5174'
    volumes:
      - ./frontend-next:/app
      - /app/node_modules
      - /app/.next
    depends_on:
      - backend
    networks:
      - escambo-net

volumes:
  mysql_data:
    driver: local

networks:
  escambo-net:
    driver: bridge
